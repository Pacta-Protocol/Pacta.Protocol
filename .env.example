# Pacta — deployment environment template
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real keys.
#   cp .env.example .env
# Load before running deploy scripts:
#   set -a; source .env; set +a
# For the funded mainnet key, prefer passing it INLINE on the command instead of
# storing it on disk at all (a leading space keeps it out of zsh history):
#    DEPLOY_SIGNER_KEY=0x... node scripts/deploy-anchor-registry.js

# ─── AnchorRegistry deploy (P0) ────────────────────────────────────────────────
# Network: base-sepolia (chainId 84532) to rehearse, base-mainnet (8453) for real.
DEPLOY_NETWORK=base-sepolia
# Private key of a FUNDED, DEDICATED EOA (throwaway, not your main wallet).
DEPLOY_SIGNER_KEY=0x_YOUR_FUNDED_PRIVATE_KEY
# Optional: the authorized anchorer address (defaults to the deployer).
ANCHORER_ADDRESS=
# Optional: override the public RPC (Alchemy/QuickNode/Ankr) for reliability.
DEPLOY_RPC_URL=

# ─── Anchoring service (after the AnchorRegistry is deployed) ───────────────────
ANCHOR_PROVIDER=rpc
ANCHOR_RPC_URL=https://sepolia.base.org
ANCHOR_CONTRACT_ADDRESS=0x_DEPLOYED_ANCHOR_REGISTRY_ADDRESS
ANCHOR_SIGNER_KEY=0x_ANCHORER_PRIVATE_KEY
ANCHOR_CHAIN_ID=84532
ANCHOR_WINDOW_HOURS=12

# ─── EscrowVault deploy (P1, Base Sepolia testnet only) ────────────────────────
VAULT_SIGNER_KEY=0x_YOUR_SEPOLIA_DEPLOYER_KEY
VAULT_RPC_URL=https://sepolia.base.org
VAULT_CHAIN_ID=84532
# Optional overrides:
VAULT_GUARDIAN=
VAULT_TVL_CAP=
VAULT_CONTRACT_ADDRESS=

# ─── Settlement backend selection (runtime) ────────────────────────────────────
# ledger (default, no wallet/chain/crypto) | base-escrow-vault
SETTLEMENT_BACKEND=ledger
